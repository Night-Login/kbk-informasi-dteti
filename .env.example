# Copy this file to .env, replace every placeholder, then run:
# chmod 600 .env
# Never commit .env or paste its values into logs or issue trackers.

# PostgreSQL
POSTGRES_DB=kbk-backend
POSTGRES_USER=postgres
# Use a long base64url value so it is also safe inside the backend DB URL.
POSTGRES_PASSWORD=replace-with-a-long-base64url-database-password

# Used only by the local be/docker-compose.yml development workflow.
POSTGRES_PORT=5432

# REDIS URL
REDIS_URL=redis://redis:6379

# Express API
# Exact, comma-separated browser origins. Do not add paths or trailing slashes.
# Local values remain here for the development workflows. On the server,
# replace the entire value and retain only approved Vercel/custom domains.
FRONTEND_URLS=http://localhost,http://localhost:3000,https://your-project.vercel.app,https://www.example.org
JWT_SECRET=replace-with-a-long-base64url-jwt-secret
JWT_EXPIRES_IN=2h
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Used only by the explicitly approved, manual seed command.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-admin-password

# Remotely-managed Cloudflare Tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-cloudflare-tunnel-token

# Daily PostgreSQL backup at 02:00 Asia/Jakarta, retained locally for 14 days.
TZ=Asia/Jakarta
BACKUP_CRON_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=14

# Docker json-file log rotation.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
