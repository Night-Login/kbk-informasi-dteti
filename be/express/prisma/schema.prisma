// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
}

enum Status {
  PLANNED
  ONGOING
  COMPLETED
}

enum Visibility {
  PUBLIC
  INTERNAL
  HIDDEN
}

model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  role      Role      @default(ADMIN)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model ResearchCluster {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String        @unique
  description       String?
  sort_order        Int?
  image_url         String?
  media_id          String?       @db.Uuid
  media             MediaAsset?   @relation(fields: [media_id], references: [id], onDelete: SetNull)
  deleted_at        DateTime?
  tags              ResearchTag[]
  primary_lecturers Lecturer[]

  @@map("research_clusters")
}

model ResearchTag {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String                @unique
  cluster_id  String                @db.Uuid
  description String?
  is_active   Boolean               @default(true)
  deleted_at  DateTime?
  cluster     ResearchCluster       @relation(fields: [cluster_id], references: [id])
  lecturers   LecturerResearchTag[]
  projects    ProjectResearchTag[]

  @@map("research_tags")
}

model Project {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String               @unique
  description      String?
  status           Status               @default(PLANNED)
  start_year       Int?
  end_year         Int?
  partner_names    String?
  funding_source   String?
  visibility       Visibility?          @default(PUBLIC)
  lead_lecturer_id String?              @db.Uuid
  lead_lecturer    Lecturer?            @relation("ProjectLead", fields: [lead_lecturer_id], references: [id], onDelete: SetNull)
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  deleted_at       DateTime?
  research_tags    ProjectResearchTag[]
  participants     LecturerProject[]

  @@map("projects")
}

model ProjectResearchTag {
  project_id String      @db.Uuid
  tag_id     String      @db.Uuid
  project    Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tag        ResearchTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([project_id, tag_id])
  @@map("project_research_tags")
}

model LecturerProject {
  project_id  String   @db.Uuid
  lecturer_id String   @db.Uuid
  role        String?
  project     Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  lecturer    Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@id([project_id, lecturer_id])
  @@map("lecturer_projects")
}

model LecturerResearchTag {
  lecturer_id String      @db.Uuid
  tag_id      String      @db.Uuid
  is_primary  Boolean     @default(false)
  lecturer    Lecturer    @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)
  tag         ResearchTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([lecturer_id, tag_id])
  @@map("lecturer_research_tags")
}

model Lecturer {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                   String
  academic_title              String?
  slug                        String                    @unique
  nip_or_staff_id             String
  email                       String?
  photo_url                   String?
  media_id                    String?                   @db.Uuid
  media                       MediaAsset?               @relation(fields: [media_id], references: [id], onDelete: SetNull)
  short_bio                   String?
  bio                         String?
  sinta_id                    String                    @unique
  scopus_author_id            String?
  google_scholar_url          String?
  google_scholar_id           String?
  orcid_id                    String?
  openalex_author_id          String?
  semantic_scholar_id         String?
  supervision_status          String?
  is_active                   Boolean                   @default(true)
  source_csv_row_ref          String?
  primary_research_cluster_id String?                   @db.Uuid
  created_at                  DateTime                  @default(now())
  updated_at                  DateTime                  @updatedAt
  deleted_at                  DateTime?
  metrics                     LecturerMetric?
  publications                LecturerPublication[]
  research_tags               LecturerResearchTag[]
  led_projects                Project[]                 @relation("ProjectLead")
  member_projects             LecturerProject[]
  primary_research_cluster    ResearchCluster?          @relation(fields: [primary_research_cluster_id], references: [id])
  supervised_students         SupervisedStudent[]
  teaching_assistants         TeachingAssistant[]
  supervision_quota           LecturerSupervisionQuota?
  education                   LecturerEducation[]
  awards                      LecturerAward[]

  @@map("lecturers")
}

model LecturerMetric {
  lecturer_id     String   @id @db.Uuid
  h_index         Int      @default(0)
  total_citations Int      @default(0)
  sinta_score     Float?
  source          String?
  fetched_at      DateTime @default(now())
  lecturer        Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@map("lecturer_metrics")
}

model Publication {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String
  year             Int
  publication_date String?
  authors_text     String?
  venue            String?
  publication_type String?
  doi              String?               @unique
  url              String?
  abstract         String?
  citation_count   Int                   @default(0)
  source           String                @default("OPENALEX")
  external_ids     Json?
  verified_status  String                @default("NEEDS_REVIEW")
  fetch_batch_id   String?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  deleted_at       DateTime?
  lecturers        LecturerPublication[]

  @@index([source])
  @@map("publications")
}

model LecturerPublication {
  lecturer_id    String      @db.Uuid
  publication_id String      @db.Uuid
  author_order   Int?
  lecturer       Lecturer    @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)
  publication    Publication @relation(fields: [publication_id], references: [id], onDelete: Cascade)

  @@id([lecturer_id, publication_id])
  @@map("lecturer_publications")
}

model SupervisedStudent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturer_id       String    @db.Uuid
  student_name      String
  student_id_number String?
  program_level     String? // S1, S2, S3
  thesis_title      String?
  supervision_role  String?
  status            String?
  start_date        DateTime? @db.Date
  end_date          DateTime? @db.Date
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  lecturer Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@index([lecturer_id])
  @@map("supervised_students")
}

model TeachingAssistant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturer_id       String    @db.Uuid
  student_name      String
  student_id_number String?
  course_name       String?
  academic_period   String?
  status            String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  lecturer Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@index([lecturer_id])
  @@map("teaching_assistants")
}

model LecturerSupervisionQuota {
  lecturer_id            String    @id @db.Uuid
  max_quota              Int?
  current_students_count Int       @default(0)
  academic_period        String?
  source                 String?
  updated_at             DateTime  @default(now()) @updatedAt
  deleted_at             DateTime?

  lecturer Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@map("lecturer_supervision_quota")
}

model LecturerEducation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturer_id String   @db.Uuid
  degree      String
  institution String
  field       String?
  year        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  lecturer Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@index([lecturer_id])
  @@map("lecturer_education")
}

model LecturerAward {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturer_id String   @db.Uuid
  name        String
  institution String?
  year        String?
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  lecturer Lecturer @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)

  @@index([lecturer_id])
  @@map("lecturer_awards")
}

model MediaAsset {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  alt_text          String?
  file_url          String?
  file_name         String?
  mime_type         String?
  file_size         Int?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  settings          SiteSetting[]
  news              NewsArticle[]
  events            Event[]
  research_clusters ResearchCluster[]
  lecturers         Lecturer[]

  @@map("media_assets")
}

model SiteSetting {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String      @unique
  label       String
  value       String?
  description String?
  field_type  String      @default("TEXT")
  sort_order  Int         @default(0)
  media_id    String?     @db.Uuid
  media       MediaAsset? @relation(fields: [media_id], references: [id], onDelete: SetNull)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@map("site_settings")
}

model AcademicProgram {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  overview     String
  information  String?
  link_url     String
  sort_order   Int      @default(0)
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("academic_programs")
}

model Scholarship {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  overview     String
  information  String?
  link_url     String
  sort_order   Int      @default(0)
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("scholarships")
}

model NewsArticle {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  slug         String      @unique
  excerpt      String
  body         String?
  link_url     String?
  image_url    String?
  media_id     String?     @db.Uuid
  media        MediaAsset? @relation(fields: [media_id], references: [id], onDelete: SetNull)
  published_at DateTime    @default(now())
  is_published Boolean     @default(true)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@index([is_published, published_at])
  @@map("news_articles")
}

model Event {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  slug         String      @unique
  description  String?
  starts_at    DateTime
  ends_at      DateTime?
  location     String
  link_url     String?
  image_url    String?
  media_id     String?     @db.Uuid
  media        MediaAsset? @relation(fields: [media_id], references: [id], onDelete: SetNull)
  is_published Boolean     @default(true)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@index([is_published, starts_at])
  @@map("events")
}
